# ---------------------------------------------------------------------------
# Katalis AI Gateway — konfigurasi PRODUKSI
#
# Cara pakai:  cp .env.production .env  lalu isi setiap nilai <...> di bawah.
# File `.env` TIDAK masuk git. File ini sengaja hanya berisi placeholder.
# ---------------------------------------------------------------------------

# --- Wajib: aplikasi menolak start bila kosong/lemah -----------------------
# Postgres. Untuk docker-compose pakai host `postgres`, untuk host langsung
# pakai 127.0.0.1. Format: postgres://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=<postgres://katalis:PASSWORD_KUAT@postgres:5432/katalis>

# Redis. docker-compose: `redis`, host langsung: 127.0.0.1
REDIS_URL=<redis://redis:6379>

# Minimal 32 karakter acak. Buat dengan:
#   openssl rand -hex 32
JWT_SECRET=<32-byte-random-hex>

# Origin frontend yang boleh mengirim cookie sesi (tanpa spasi).
# Contoh: https://katalis.sh  atau  http://192.168.1.10:8080
CORS_ORIGINS=<https://domain-anda>

# --- Mode runtime ----------------------------------------------------------
# HARUS `production`.
NODE_ENV=production
# `true` bila situs dilayani lewat HTTPS (wajib untuk publik).
COOKIE_SECURE=<true|false>

# --- Upstream AI (isi minimal satu per model yang Anda jual) --------------
# Tanpa ini `POST /v1/chat/completions` selalu 502 (katalog tetap tampil).
UPSTREAM_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
UPSTREAM_SILICONFLOW_API_KEY=<isi>

UPSTREAM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
UPSTREAM_DEEPSEEK_API_KEY=<isi>

UPSTREAM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
UPSTREAM_ZHIPU_API_KEY=<isi>

UPSTREAM_VOLCENGINE_BASE_URL=<https://ark.cn-beijing.volces.com/api/v3>
UPSTREAM_VOLCENGINE_API_KEY=<isi>

# --- Pembayaran QRIS (TriPay) ---------------------------------------------
# Tanpa ini `POST /api/billing/invoices` selalu 502.
QRIS_PROVIDER=TRIPAY
TRIPAY_API_KEY=<isi>
TRIPAY_MERCHANT_CODE=<isi>
# Dipakai memverifikasi `x-tripay-signature`. HARUS sama dengan dashboard TriPay.
QRIS_WEBHOOK_SECRET=<isi>

# --- Tuning opsional (abaikan bila tidak yakin) ---------------------------
# Batas waktu byte pertama dari upstream sebelum failover (ms).
PROXY_FIRST_BYTE_TIMEOUT_MS=3000
# Jendela kuota Flex Pool (ms) dan maksimum token per jendela.
FLEX_WINDOW_MS=18000000
FLEX_WINDOW_MAX_TOKENS=1000000
